# Copy to apps/web/.env.local and fill from Supabase → Project Settings → API
# See supabase/AUTH_SETUP.md for dashboard settings (redirects, email auth).

VITE_APP_URL=http://localhost:5173
# Shown in Settings → About
# VITE_APP_VERSION=0.0.0
# VITE_APP_BUILD=dev

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New dashboard: "Publishable key" (sb_publishable_…). Legacy tab: anon key also works.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# VITE_SUPABASE_ANON_KEY=eyJ...   # optional legacy name

# Optional — live server
VITE_LIVE_URL=http://localhost:3000
VITE_ADMIN_EMAILS=you@example.com

# Phase 1f–h — OpenAI (browser key is dev-only; use edge function in production)
# VITE_OPENAI_API_KEY=sk-...
# VITE_OPENAI_MODEL=gpt-4o-mini

# Phase 2a / 4 — Paystack (public key in web; secret on live server for verify + webhooks)
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_...
# VITE_PAYMENTS_API_URL=http://localhost:3000
# On apps/live server (never commit):
# PAYSTACK_SECRET_KEY=sk_test_...

# Phase 3b — analytics (optional)
# VITE_PLAUSIBLE_DOMAIN=izora.app
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXX

# Phase 3c — Sentry (install @sentry/react when ready)
# VITE_SENTRY_DSN=https://...@sentry.io/...

# Auth: "local" = browser-only login (recommended for demo). "supabase" = Supabase Auth.
# VITE_AUTH_MODE=local

# Dev-only demo auto-login (local .env.local only — do not commit real passwords)
# VITE_DEMO_AUTO_LOGIN=true
# VITE_DEMO_EMAIL=you@example.com
# VITE_DEMO_PASSWORD=your-dev-password
# VITE_DEMO_IS_CREATOR=true
# VITE_DEMO_USER_ID=optional-stable-uuid-for-local-user
